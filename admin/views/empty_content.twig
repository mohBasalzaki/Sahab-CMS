{% extends 'layout.twig' %}
{% block title %}{{ t('مدير المحتوى') }}{% endblock %}
{% block content %}
<div class="empty-state">
  {{ icon('database', 40) }}
  <h2>{{ t('لا توجد أنواع محتوى بعد') }}</h2>
  <p class="muted">{{ t('ابدأ ببناء بنية بياناتك بنفسك: أنشئ نوعاً (مقالات، خدمات، منتجات…) وأضف حقوله، ثم فعّل المصمم لتصميم صفحاته بصرياً.') }}</p>
  {% if is_admin %}<a class="btn primary" href="{{ url('/admin/types/new') }}">{{ icon('plus', 16) }} {{ t('إنشاء أول نوع محتوى') }}</a>{% endif %}
</div>
{% endblock %}
