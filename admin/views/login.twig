{% extends 'auth_base.twig' %}
{% block title %}{{ t('تسجيل الدخول') }}{% endblock %}
{% block form %}
<h1>{{ t('تسجيل الدخول') }}</h1>
<p class="muted">{{ t('تسجيل الدخول إلى لوحة التحكم') }}</p>
{% if flash %}<div class="alert {{ flash.type }}" role="status">{{ flash.text }}</div>{% endif %}
{% if error %}<div class="alert err" role="alert">{{ error }}</div>{% endif %}
<form method="post" action="{{ url('/admin/login') }}">
  {{ csrf_field() }}
  <label for="email">{{ t('البريد الإلكتروني') }}</label>
  <input id="email" name="email" type="email" required autofocus autocomplete="username" dir="ltr" value="{{ email|default('') }}" placeholder="name@example.com">
  <div class="label-row"><label for="password">{{ t('كلمة المرور') }}</label><a href="{{ url('/admin/forgot') }}">{{ t('نسيت كلمة المرور؟') }}</a></div>
  <div class="pw-wrap"><input id="password" name="password" type="password" required autocomplete="current-password" dir="ltr"><button type="button" class="pw-toggle" data-pw-toggle aria-label="{{ t('إظهار كلمة المرور') }}">{{ icon('view', 18) }}</button></div>
  <button class="btn primary block" type="submit">{{ t('دخول') }}</button>
</form>
{% endblock %}